@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor

<MudNavMenu Class="pa-2 pt-3">

    <!-- Dashboard -->
    <MudNavLink Href="/"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Dashboard"
                IconColor="Color.Primary">
        Trang chủ
    </MudNavLink>

    <!-- ── DANH MỤC ── -->
    <div class="nav-section-label" style="margin-top:16px">DANH MỤC</div>

    <MudNavGroup Title="Danh mục"
                 Icon="@Icons.Material.Filled.Category"
                 Expanded="false"
                 IconColor="Color.Secondary">
        <MudNavLink Href="/danhmuc/khoa-monhoc"
                    Icon="@Icons.Material.Outlined.AccountBalance"
                    IconColor="Color.Secondary">
            Khoa &amp; Môn học
        </MudNavLink>
        <MudNavLink Href="/danhmuc/phan"
                    Icon="@Icons.Material.Outlined.AccountTree"
                    IconColor="Color.Secondary">
            Quản lý Phần/Chương
        </MudNavLink>
    </MudNavGroup>

    <!-- ── NỘI DUNG ── -->
    <div class="nav-section-label" style="margin-top:16px">NỘI DUNG</div>

    <MudNavLink Href="/cauhoi"
                Icon="@Icons.Material.Filled.Quiz"
                IconColor="Color.Tertiary">
        Ngân hàng Câu hỏi
    </MudNavLink>

    <MudNavLink Href="/dethi"
                Icon="@Icons.Material.Filled.Assignment"
                IconColor="Color.Primary">
        Quản lý Đề thi
    </MudNavLink>

    <!-- ── Footer info ── -->
    <div style="position:absolute; bottom:16px; left:0; right:0; padding:0 16px">
        <MudDivider Class="mb-2" />
        <MudText Typo="Typo.caption"
                 Style="color:var(--text-muted); font-size:.65rem; text-align:center; display:block">
            
        </MudText>
    </div>

</MudNavMenu>
