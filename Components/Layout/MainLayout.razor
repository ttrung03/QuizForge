@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <!-- ── AppBar ──────────────────────────────────────────────────────────── -->
    <MudAppBar Color="Color.Primary" Fixed="true" Elevation="0" Dense="false"
               Style="background: linear-gradient(135deg, #1E40AF 0%, #2563EB 100%);
                      border-bottom: 1px solid rgba(255,255,255,.12);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Inherit" Class="ml-1 mr-2"
                 Style="opacity:.9" />
        <MudText Typo="Typo.h6" Style="font-weight:700; letter-spacing:.2px; opacity:.95">
            QuestionBank
        </MudText>
        
        <MudSpacer />

        <!-- Version badge -->
        <!-- <MudChip T="string" Size="Size.Small"
                 Style="background:rgba(255,255,255,.15); color:#fff; border:1px solid rgba(255,255,255,.25);
                        border-radius:20px; font-size:.65rem; height:24px; font-weight:600; margin-right:8px">
            v1.0
        </MudChip> -->

        <!-- Avatar placeholder -->
        <!-- <div class="appbar-avatar" title="Tài khoản">
            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size:18px; color:rgba(255,255,255,.9)" />
        </div> -->
    </MudAppBar>

    <!-- ── Sidebar ─────────────────────────────────────────────────────────── -->
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Width="260px"
               Style="border-right: 1px solid var(--border-subtle); background: #FAFBFC;">
        <!-- Brand header -->
        <MudDrawerHeader Class="pa-0">
            <div style="background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
                        padding: 16px 18px; width: 100%;
                        display: flex; align-items: center; gap: 12px;">
                <div class="drawer-brand__logo">
                    <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Surface" Size="Size.Small" />
                </div>
                <div style="line-height:1.2">
                    <MudText Typo="Typo.subtitle2" Style="color:#fff; font-weight:700; font-size:.9rem">
                        QuestionBank
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.65); font-size:.7rem">
                        Quản lý câu hỏi
                    </MudText>
                </div>
            </div>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <!-- ── Nội dung chính ──────────────────────────────────────────────────── -->
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

@code {
    bool _drawerOpen = true;
    void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary         = "#2563EB",
            PrimaryDarken   = "#1D4ED8",
            PrimaryLighten  = "#3B82F6",
            Secondary       = "#7C3AED",
            Tertiary        = "#0891B2",
            AppbarBackground = "#1E40AF",
            DrawerBackground = "#FAFBFC",
            DrawerText       = "#1E293B",
            Background       = "#F1F5F9",
            Surface          = "#FFFFFF",
            TextPrimary      = "#0F172A",
            TextSecondary    = "#64748B",
            Divider          = "#E8ECF0",
            TableLines       = "#E8ECF0",
            TableStriped     = "#FAFBFC",
            TableHover       = "#F1F5F9",
            OverlayDark      = "rgba(15,23,42,.6)",
            ActionDefault    = "#64748B",
            LinesInputs      = "#CBD5E1",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"],
                FontSize   = ".875rem",
                LineHeight = "1.6",
            },
            H5 = new H5Typography { FontWeight = "700", LetterSpacing = "-.01em" },
            H6 = new H6Typography { FontWeight = "700", LetterSpacing = "-.01em" },
            Subtitle1 = new Subtitle1Typography { FontWeight = "600" },
            Subtitle2 = new Subtitle2Typography { FontWeight = "600" },
            Button    = new ButtonTypography
            {
                FontWeight    = "600",
                TextTransform = "none",
                LetterSpacing = "0",
                FontSize      = ".875rem",
            },
        },
    };
}
