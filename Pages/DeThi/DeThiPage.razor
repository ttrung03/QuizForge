@page "/dethi"
@using MudBlazor
@using QuestionBank.Web.Application.DTOs
@using QuestionBank.Web.Application.Services
@using QuestionBank.Web.Components.Shared
@inject DeThiService DeThiService
@inject MonHocService MonHocService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Quản lý Đề thi</PageTitle>

@* ── Hero Header ── *@
<div class="dethi-hero mb-5">
    <div class="d-flex align-center gap-3">
        <div class="dethi-hero__icon">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Style="font-size:2rem; color:#fff" />
        </div>
        <div>
            <MudText Typo="Typo.h5" Style="font-weight:700; color:#fff; margin:0">Quản lý Đề thi</MudText>
            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.8); margin:0">
                Tạo, quản lý và phê duyệt đề thi theo môn học
            </MudText>
        </div>
        @if (_deThiList.Count > 0)
        {
            <div class="ml-auto d-flex gap-3">
                <div class="dethi-hero__stat">
                    <span class="dethi-hero__stat-val">@_deThiList.Count</span>
                    <span class="dethi-hero__stat-lbl">Tổng đề</span>
                </div>
                <div class="dethi-hero__stat">
                    <span class="dethi-hero__stat-val" style="color:#86efac">@_deThiList.Count(d => d.DaDuyet == true)</span>
                    <span class="dethi-hero__stat-lbl">Đã duyệt</span>
                </div>
                <div class="dethi-hero__stat">
                    <span class="dethi-hero__stat-val" style="color:#fde047">@_deThiList.Count(d => d.DaDuyet != true)</span>
                    <span class="dethi-hero__stat-lbl">Chờ duyệt</span>
                </div>
            </div>
        }
    </div>
</div>

@* ── Filter + Action ── *@
<MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius:12px">
    <div class="d-flex gap-3 align-stretch flex-wrap">
        <div style="flex:1; min-width:220px">
            <MudSelect T="Guid"
                       Value="_maMonHoc"
                       ValueChanged="OnMonHocChanged"
                       Label="Chọn Môn học"
                       Variant="Variant.Outlined"
                       Clearable="true"
                       AdornmentIcon="@Icons.Material.Filled.School"
                       Adornment="Adornment.Start"
                       Style="height:56px">
                @foreach (var mh in _monHocList)
                {
                    <MudSelectItem Value="@mh.MaMonHoc">@mh.TenMonHoc</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div style="flex:0 0 auto; min-width:200px; display:flex; align-items:stretch">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.NoteAdd"
                       Disabled="@(_maMonHoc == Guid.Empty)"
                       OnClick="OpenCreateDialog"
                       FullWidth="true"
                       Style="border-radius:8px; font-weight:600; text-transform:none; letter-spacing:0; height:56px; font-size:15px">
                Tạo đề thi mới
            </MudButton>
        </div>
    </div>
</MudPaper>


@* ── Content ── *@
@if (_maMonHoc == Guid.Empty)
{
    <div class="dethi-empty">
        <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Style="font-size:3.5rem; color:#cbd5e1; margin-bottom:12px" />
        <MudText Typo="Typo.h6" Style="color:#64748b; font-weight:600">Chưa chọn môn học</MudText>
        <MudText Typo="Typo.body2" Style="color:#94a3b8">Vui lòng chọn môn học ở trên để xem danh sách đề thi</MudText>
    </div>
}
else if (_loading)
{
    <div class="pa-6 text-center">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">Đang tải danh sách đề thi…</MudText>
    </div>
}
else if (_deThiList.Count == 0)
{
    <div class="dethi-empty">
        <MudIcon Icon="@Icons.Material.Filled.PostAdd" Style="font-size:3.5rem; color:#cbd5e1; margin-bottom:12px" />
        <MudText Typo="Typo.h6" Style="color:#64748b; font-weight:600">Chưa có đề thi nào</MudText>
        <MudText Typo="Typo.body2" Style="color:#94a3b8">Nhấn <b>Tạo đề thi mới</b> để bắt đầu</MudText>
    </div>
}
else
{
    <div class="dethi-list">
        @foreach (var dt in _deThiList)
        {
            <MudPaper Elevation="0" Class="dethi-card mb-3" Style="border-radius:12px; border:1px solid #e2e8f0; overflow:hidden">
                @* Card Header *@
                <div class="dethi-card__header" style="@(dt.DaDuyet == true ? "border-left:4px solid #22c55e" : "border-left:4px solid #f59e0b")">
                    <div class="d-flex align-center flex-wrap gap-2" style="width:100%">
                        <MudIcon Icon="@Icons.Material.Filled.Description"
                                 Size="Size.Medium"
                                 Color="@(dt.DaDuyet == true ? Color.Success : Color.Warning)"
                                 Class="mr-1 flex-shrink-0" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body1" Style="font-weight:700; line-height:1.3">@dt.TenDeThi</MudText>
                            <div class="d-flex align-center gap-2 mt-1 flex-wrap">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Style="font-size:12px;vertical-align:middle;margin-right:2px" />
                                    @dt.NgayTao.ToString("dd/MM/yyyy HH:mm")
                                </MudText>
                                @if (dt.MaDe.HasValue)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Filled.Tag" Style="height:22px">
                                        Mã đề: @dt.MaDe.Value.ToString("D3")
                                    </MudChip>
                                }
                            </div>
                        </div>

                        @* Badges *@
                        <div class="d-flex align-center gap-2 flex-wrap">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                     Icon="@Icons.Material.Filled.Quiz" Style="height:24px; font-weight:600">
                                @dt.SoCauHoi câu
                            </MudChip>
                            @if (dt.ChiTietDeThis.Count > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Style="height:24px">
                                    Dễ: @dt.ChiTietDeThis.Count(c => c.CapDo == 1)
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Style="height:24px">
                                    TB: @dt.ChiTietDeThis.Count(c => c.CapDo == 2)
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Style="height:24px">
                                    Khó: @dt.ChiTietDeThis.Count(c => c.CapDo >= 3)
                                </MudChip>
                            }
                            <MudChip T="string" Size="Size.Small"
                                     Icon="@(dt.DaDuyet == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.PendingActions)"
                                     Color="@(dt.DaDuyet == true ? Color.Success : Color.Warning)"
                                     Style="height:24px; font-weight:600">
                                @(dt.DaDuyet == true ? "Đã duyệt" : "Chờ duyệt")
                            </MudChip>
                        </div>

                        @* Action buttons *@
                        <span @onclick:stopPropagation="true" class="d-flex gap-1 ml-2">
                            <MudTooltip Text="Xem trước đề thi" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Small" Color="Color.Info"
                                               Variant="Variant.Outlined"
                                               Class="dethi-action-btn"
                                               OnClick="@(() => OpenPreviewDialog(dt))" />
                            </MudTooltip>
                            <MudTooltip Text="Sinh nhiều bản đề" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Filled.CopyAll"
                                               Size="Size.Small" Color="Color.Secondary"
                                               Variant="Variant.Outlined"
                                               Class="dethi-action-btn"
                                               Disabled="@(dt.SoCauHoi == 0)"
                                               OnClick="@(() => OpenSinhNhieuMaDeDialog(dt))" />
                            </MudTooltip>
                            @if (dt.DaDuyet != true)
                            {
                                <MudTooltip Text="Phê duyệt đề thi" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                                   Size="Size.Small" Color="Color.Success"
                                                   Variant="Variant.Outlined"
                                                   Class="dethi-action-btn"
                                                   OnClick="@(() => DuyetAsync(dt))" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="Hủy phê duyệt" Arrow="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                   Size="Size.Small" Color="Color.Warning"
                                                   Variant="Variant.Outlined"
                                                   Class="dethi-action-btn"
                                                   OnClick="@(() => HuyDuyetAsync(dt))" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="@(dt.DaDuyet == true ? "Không thể xóa đề đã duyệt" : "Xóa đề thi")" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small" Color="Color.Error"
                                               Variant="Variant.Outlined"
                                               Class="dethi-action-btn"
                                               Disabled="@(dt.DaDuyet == true)"
                                               OnClick="@(() => DeleteAsync(dt.MaDeThi, dt.TenDeThi))" />
                            </MudTooltip>
                        </span>
                    </div>
                </div>

                @* Card Body — question table *@
                @if (dt.ChiTietDeThis.Count > 0)
                {
                    <MudExpansionPanels Elevation="0">
                        <MudExpansionPanel Style="box-shadow:none">
                            <TitleContent>
                                <MudText Typo="Typo.caption" Style="color:#64748b; font-weight:600; text-transform:uppercase; letter-spacing:0.5px">
                                    <MudIcon Icon="@Icons.Material.Filled.TableView" Size="Size.Small" Style="vertical-align:middle;margin-right:4px;font-size:14px" />
                                    Xem chi tiết câu hỏi (@dt.SoCauHoi câu)
                                </MudText>
                            </TitleContent>
                            <ChildContent>
                                @foreach (var phanGroup in dt.ChiTietDeThis.GroupBy(c => c.TenPhan))
                                {
                                    <div class="dethi-phan-label">
                                        <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Small" Style="font-size:13px;vertical-align:middle;margin-right:4px" />
                                        PHẦN: @phanGroup.Key
                                        <MudChip T="string" Size="Size.Small" Style="height:18px; font-size:11px; margin-left:6px">@phanGroup.Count() câu</MudChip>
                                    </div>
                                    <div class="dethi-table-wrap mb-3">
                                        <table class="dethi-table">
                                            <thead>
                                                <tr>
                                                    <th style="width:48px">STT</th>
                                                    <th>Nội dung câu hỏi</th>
                                                    <th style="width:220px">Đáp án đúng</th>
                                                    <th style="width:80px">Cấp độ</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{ int stt = 0; }
                                                @foreach (var cauHoi in phanGroup)
                                                {
                                                    @if (cauHoi.LaCauNhom)
                                                    {
                                                        <tr class="dethi-table__group-header">
                                                            <td colspan="1"></td>
                                                            <td colspan="3">
                                                                <div class="d-flex align-center gap-1 mb-1">
                                                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Style="font-size:13px;color:#5c6bc0" />
                                                                    <span class="dethi-group-badge">Nhóm câu hỏi — @cauHoi.CauHoiCons.Count câu con</span>
                                                                    @if (cauHoi.Files.Any(f => f.LoaiFile == 1))
                                                                    {
                                                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" Color="Color.Info" Style="font-size:13px" />
                                                                    }
                                                                    @if (cauHoi.Files.Any(f => f.LoaiFile == 2))
                                                                    {
                                                                        <MudIcon Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Color="Color.Secondary" Style="font-size:13px" />
                                                                    }
                                                                </div>
                                                                <div style="color:#475569; font-style:italic">@Truncate(cauHoi.NoiDung ?? "", 200)</div>
                                                            </td>
                                                        </tr>
                                                        @foreach (var con in cauHoi.CauHoiCons)
                                                        {
                                                            stt++;
                                                            var correctCon = con.CauTraLois.FirstOrDefault(a => a.LaDapAn);
                                                            var idxCon     = correctCon is null ? -1 : con.CauTraLois.OrderBy(a => a.ThuTu).ToList().IndexOf(correctCon);
                                                            string lblCon  = correctCon is null
                                                                ? "—"
                                                                : $"{(idxCon >= 0 && idxCon < 4 ? "ABCD"[idxCon] : '?')}. {Truncate(correctCon.NoiDung ?? "", 40)}";
                                                            <tr class="dethi-table__child-row">
                                                                <td class="stt-cell">@stt</td>
                                                                <td>
                                                                    @Truncate(con.NoiDung ?? "", 120)
                                                                    @if (con.Files.Any(f => f.LoaiFile == 1))
                                                                    {
                                                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" Color="Color.Info" Style="font-size:12px;vertical-align:middle;margin-left:3px" />
                                                                    }
                                                                    @if (con.Files.Any(f => f.LoaiFile == 2))
                                                                    {
                                                                        <MudIcon Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Color="Color.Secondary" Style="font-size:12px;vertical-align:middle;margin-left:2px" />
                                                                    }
                                                                </td>
                                                                <td class="answer-cell">@lblCon</td>
                                                                <td>
                                                                    <MudChip T="string" Size="Size.Small" Color="@CapDoColor(con.CapDo)" Style="height:22px">
                                                                        @CapDoLabel(con.CapDo)
                                                                    </MudChip>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        stt++;
                                                        var correct = cauHoi.CauTraLois.FirstOrDefault(a => a.LaDapAn);
                                                        var idx     = correct is null ? -1 : cauHoi.CauTraLois.OrderBy(a => a.ThuTu).ToList().IndexOf(correct);
                                                        string lbl  = correct is null
                                                            ? "—"
                                                            : $"{(idx >= 0 && idx < 4 ? "ABCD"[idx] : '?')}. {Truncate(correct.NoiDung ?? "", 40)}";
                                                        <tr class="dethi-table__row">
                                                            <td class="stt-cell">@stt</td>
                                                            <td>
                                                                @Truncate(cauHoi.NoiDung ?? "", 120)
                                                                @if (cauHoi.Files.Any(f => f.LoaiFile == 1))
                                                                {
                                                                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" Color="Color.Info" Style="font-size:12px;vertical-align:middle;margin-left:3px" />
                                                                }
                                                                @if (cauHoi.Files.Any(f => f.LoaiFile == 2))
                                                                {
                                                                    <MudIcon Icon="@Icons.Material.Filled.Audiotrack" Size="Size.Small" Color="Color.Secondary" Style="font-size:12px;vertical-align:middle;margin-left:2px" />
                                                                }
                                                            </td>
                                                            <td class="answer-cell">@lbl</td>
                                                            <td>
                                                                <MudChip T="string" Size="Size.Small" Color="@CapDoColor(cauHoi.CapDo)" Style="height:22px">
                                                                    @CapDoLabel(cauHoi.CapDo)
                                                                </MudChip>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </ChildContent>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
                else
                {
                    <div class="px-4 py-3">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Style="vertical-align:middle;margin-right:4px" />
                            Đề thi chưa có câu hỏi.
                        </MudText>
                    </div>
                }
            </MudPaper>
        }
    </div>
}

@code {
    List<MonHocDto> _monHocList = [];
    List<DeThiDto>  _deThiList  = [];
    Guid _maMonHoc = Guid.Empty;
    bool _loading  = false;

    protected override async Task OnInitializedAsync()
        => _monHocList = await MonHocService.GetAllAsync();

    private async Task OnMonHocChanged(Guid maMonHoc)
    {
        _maMonHoc  = maMonHoc;
        _deThiList = [];
        await LoadDeThiAsync();
    }

    private async Task LoadDeThiAsync()
    {
        if (_maMonHoc == Guid.Empty) return;
        _loading = true;
        try   { _deThiList = await DeThiService.GetByMonHocAsync(_maMonHoc); }
        finally { _loading = false; }
    }

    // ── Tạo đề thi ───────────────────────────────────────────────────────────
    private async Task OpenCreateDialog()
    {
        var options    = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters<TaoDeThiDialog>
        {
            { x => x.MaMonHoc, _maMonHoc }
        };
        var dialog = await DialogService.ShowAsync<TaoDeThiDialog>("Tạo đề thi mới", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: SaveDeThiDto dto })
        {
            await DeThiService.SaveAsync(dto);
            Snackbar.Add($"Đã tạo đề thi \"{dto.TenDeThi}\" với {dto.CauHois.Count} câu.", Severity.Success);
            await LoadDeThiAsync();
        }
    }

    // ── Sinh nhiều mã đề ──────────────────────────────────────────────────────
    private async Task OpenSinhNhieuMaDeDialog(DeThiDto dt)
    {
        var options    = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<SinhNhieuMaDeDialog>
        {
            { x => x.DeThi,    dt },
            { x => x.MaMonHoc, _maMonHoc }
        };
        var dialog = await DialogService.ShowAsync<SinhNhieuMaDeDialog>("Sinh nhiều mã đề", parameters, options);
        var result = await dialog.Result;
        // Reload nếu đã sinh thành công (result.Data = true)
        if (result is { Canceled: false, Data: true })
        {
            Snackbar.Add("Đã thêm các bản đề mới vào danh sách.", Severity.Info);
            await LoadDeThiAsync();
        }
    }

    // ── Xem trước ────────────────────────────────────────────────────────────
    private async Task OpenPreviewDialog(DeThiDto dt)
    {
        var tenMonHoc = _monHocList.FirstOrDefault(m => m.MaMonHoc == _maMonHoc)?.TenMonHoc ?? "";
        var options   = new DialogOptions
        {
            MaxWidth  = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };
        var parameters = new DialogParameters<PreviewDeThiDialog>
        {
            { x => x.DeThi,      dt },
            { x => x.TenMonHoc,  tenMonHoc },
            { x => x.MaMonHoc,   _maMonHoc }
        };
        var dialog = await DialogService.ShowAsync<PreviewDeThiDialog>("", parameters, options);
        await dialog.Result;
        // Đồng bộ trạng thái DaDuyet về list (dialog có thể đã phê duyệt)
        await LoadDeThiAsync();
    }

    // ── Phê duyệt ────────────────────────────────────────────────────────────
    private async Task DuyetAsync(DeThiDto dt)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Xác nhận phê duyệt",
            $"Phê duyệt đề thi \"{dt.TenDeThi}\"?\nSau khi duyệt, đề thi sẽ không thể xóa.",
            yesText: "Duyệt", cancelText: "Hủy");

        if (confirmed == true)
        {
            await DeThiService.DuyetAsync(dt.MaDeThi);
            dt.DaDuyet = true;          // cập nhật local ngay, không cần reload
            Snackbar.Add($"Đã phê duyệt \"{dt.TenDeThi}\".", Severity.Success);
            StateHasChanged();
        }
    }

    private async Task HuyDuyetAsync(DeThiDto dt)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Xác nhận hủy duyệt",
            $"Hủy phê duyệt đề thi \"{dt.TenDeThi}\"?",
            yesText: "Hủy duyệt", cancelText: "Thôi");

        if (confirmed == true)
        {
            await DeThiService.HuyDuyetAsync(dt.MaDeThi);
            dt.DaDuyet = false;
            Snackbar.Add($"Đã hủy duyệt \"{dt.TenDeThi}\".", Severity.Warning);
            StateHasChanged();
        }
    }

    // ── Xóa ──────────────────────────────────────────────────────────────────
    private async Task DeleteAsync(Guid maDeThi, string tenDeThi)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Xác nhận xóa",
            $"Xóa đề thi \"{tenDeThi}\"? Thao tác này không thể hoàn tác.",
            yesText: "Xóa", cancelText: "Hủy");

        if (confirmed == true)
        {
            await DeThiService.DeleteAsync(maDeThi);
            Snackbar.Add("Đã xóa đề thi.", Severity.Success);
            await LoadDeThiAsync();
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static string Truncate(string s, int max)
        => s.Length <= max ? s : s[..max] + "…";

    private static Color CapDoColor(short cap) => cap switch
    {
        1 => Color.Success,
        2 => Color.Warning,
        _ => Color.Error
    };

    private static string CapDoLabel(short cap) => cap switch
    {
        1 => "Dễ",
        2 => "TB",
        _ => "Khó"
    };
}
